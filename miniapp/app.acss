page {
  background: #F8F3ED;
  color: #231E1A;
  font-family: "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.85;
  letter-spacing: 0.4rpx;
}

.page {
  padding: 24rpx 32rpx 120rpx;
}

.serif {
  font-family: "Songti SC", "Noto Serif SC", "Source Han Serif SC", serif;
}

/* ---------- 通用 ---------- */
.card {
  background: #FFFCF8;
  border: 1rpx solid #E7DCD1;
  border-radius: 32rpx;
  padding: 44rpx 40rpx;
  margin-top: 28rpx;
  box-shadow: 0 20rpx 60rpx -48rpx rgba(63, 42, 30, 0.5);
}

.kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #9E5A45;
  text-transform: uppercase;
  margin-bottom: 14rpx;
}

.sub-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #231E1A;
  margin-bottom: 14rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 38rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1.4;
  border: 1rpx solid transparent;
  box-sizing: border-box;
  max-width: 100%;
  text-align: center;
}

.btn-primary {
  background: #9E5A45;
  color: #FFF8F3;
  box-shadow: 0 16rpx 34rpx -24rpx rgba(126, 69, 52, 0.9);
}

.btn-primary-hover {
  background: #7E4534;
}

.btn-ghost {
  border-color: #D9C9BA;
  color: #544B44;
  background: transparent;
}

.btn-ghost-hover {
  border-color: #9E5A45;
  color: #7E4534;
}

.btn-quiet {
  color: #8B8078;
  padding: 18rpx 22rpx;
  background: transparent;
}

.row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 26rpx;
}

.row .btn {
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.5;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
}

.tag-fact {
  background: #E9EFE5;
  color: #5F7259;
  border-color: #D8E2D2;
}

.tag-hyp {
  background: #F6EBD8;
  color: #94702F;
  border-color: #EBD9BB;
}

.tag-unknown {
  background: #E8EEF0;
  color: #6B7A83;
  border-color: #DCE5E8;
}

.tag-guess {
  background: #FFFFFF;
  color: #8B8078;
  border-color: #D9C9BA;
  border-style: dashed;
}

.note {
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  border: 1rpx dashed #D9C9BA;
  border-radius: 24rpx;
  background: #FBF6F0;
}

.note-p {
  font-size: 26rpx;
  color: #544B44;
  margin-top: 10rpx;
  word-break: break-all;
}

.mt-lg {
  margin-top: 34rpx;
}

.mt-0 {
  margin-top: 0;
}

.fw-600 {
  font-weight: 600;
}

.mode-note {
  margin-top: 22rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #B0A399;
}

.disclaimer {
  margin-top: 30rpx;
  padding-left: 22rpx;
  border-left: 2rpx solid #D9C9BA;
  font-size: 24rpx;
  line-height: 1.9;
  color: #8B8078;
}

.empty {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #8B8078;
  line-height: 1.9;
}

.acc {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #E7DCD1;
}

.acc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #8B8078;
}

.acc-icon {
  font-size: 34rpx;
  color: #9E5A45;
  line-height: 1;
}

.acc-body {
  padding-top: 16rpx;
  font-size: 26rpx;
  color: #544B44;
}

.acc-flush {
  margin-top: 0;
  padding-top: 0;
  border-top: 0;
}

.report-card {
  padding: 8rpx 36rpx;
}

.acc-item {
  margin-bottom: 10rpx;
  line-height: 1.8;
}

/* ---------- 首页 ---------- */
.hero {
  padding: 40rpx 4rpx 10rpx;
}

.eyebrow {
  font-size: 22rpx;
  letter-spacing: 5rpx;
  color: #8B8078;
  margin-bottom: 30rpx;
}

.h1 {
  font-family: "Songti SC", "Noto Serif SC", "Source Han Serif SC", serif;
  font-size: 64rpx;
  line-height: 1.42;
  font-weight: 500;
}

.h1-accent {
  color: #9E5A45;
}

.lede {
  margin-top: 28rpx;
  font-size: 29rpx;
  line-height: 2;
  color: #544B44;
}

.lede-line {
  display: block;
}

.composer {
  padding: 12rpx 12rpx 22rpx;
}

.composer-input {
  display: block;
  width: 100%;
  min-height: 260rpx;
  padding: 32rpx 26rpx 12rpx;
  font-size: 30rpx;
  line-height: 2;
  box-sizing: border-box;
}

.composer-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 16rpx 0 26rpx;
}

.counter {
  font-size: 22rpx;
  color: #B0A399;
  letter-spacing: 1rpx;
}

.chips-title {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: #8B8078;
}

.chips {
  margin-top: 18rpx;
}

.chip {
  display: inline-block;
  padding: 14rpx 26rpx;
  margin: 0 14rpx 14rpx 0;
  border: 1rpx solid #E7DCD1;
  border-radius: 999rpx;
  background: #FFFCF8;
  color: #544B44;
  font-size: 26rpx;
}

.chip-hover {
  border-color: #C0836D;
  color: #7E4534;
}

.resume {
  margin-top: 34rpx;
  padding: 32rpx 34rpx;
  background: #FFFCF8;
  border: 1rpx solid #E7DCD1;
  border-radius: 28rpx;
}

.resume-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #8B8078;
}

.resume-text {
  margin-top: 10rpx;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 30rpx;
  line-height: 1.85;
  color: #231E1A;
}

/* ---------- 识别结果 ---------- */
.reflect {
  padding: 10rpx 4rpx 0;
}

.quote {
  padding-left: 26rpx;
  border-left: 4rpx solid #C0836D;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 38rpx;
  line-height: 1.85;
  color: #231E1A;
}

.lead {
  margin-top: 26rpx;
  font-size: 29rpx;
  line-height: 1.95;
  color: #544B44;
}

.elements {
  margin-top: 28rpx;
  padding: 30rpx 30rpx 16rpx;
  border: 1rpx dashed #D9C9BA;
  border-radius: 26rpx;
  background: rgba(255, 252, 248, 0.6);
}

.element {
  margin-bottom: 22rpx;
}

.element-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #8B8078;
  margin-bottom: 8rpx;
}

.pill {
  display: inline-block;
  padding: 4rpx 14rpx;
  margin: 0 10rpx 10rpx 0;
  border: 1rpx solid #E7DCD1;
  border-radius: 10rpx;
  background: #FBF6F0;
  color: #544B44;
  font-size: 25rpx;
  line-height: 1.7;
}

.pill-guess {
  border-style: dashed;
  color: #8B8078;
}

.followup-title {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 36rpx;
  font-weight: 600;
}

.followup-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #544B44;
  line-height: 1.85;
}

.q {
  margin-top: 26rpx;
}

.q-text {
  font-size: 27rpx;
  color: #231E1A;
  margin-bottom: 10rpx;
}

.q-input {
  display: block;
  width: 100%;
  min-height: 110rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #E7DCD1;
  border-radius: 20rpx;
  background: #FFFDFA;
  font-size: 27rpx;
  line-height: 1.8;
  box-sizing: border-box;
}

.concept {
  position: relative;
  padding-left: 46rpx;
}

.concept-line {
  position: absolute;
  left: 0;
  top: 48rpx;
  bottom: 48rpx;
  width: 5rpx;
  border-radius: 3rpx;
  background: #9E5A45;
}

.concept-name {
  margin-top: 6rpx;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 54rpx;
  font-weight: 600;
  line-height: 1.4;
}

.concept-plain {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #7E4534;
}

.concept-def {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #E7DCD1;
  font-size: 26rpx;
  line-height: 1.95;
  color: #544B44;
}

.banner {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #EBD9BB;
  border-radius: 18rpx;
  background: #F6EBD8;
  font-size: 24rpx;
  line-height: 1.8;
  color: #6E5322;
}

.hit {
  position: relative;
  padding-left: 22rpx;
  margin-bottom: 12rpx;
  font-size: 27rpx;
  line-height: 1.85;
  color: #544B44;
}

.hit-dot {
  position: absolute;
  left: 0;
  top: 18rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #C0836D;
}

.related-item {
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #E7DCD1;
  font-size: 26rpx;
  color: #544B44;
  word-break: break-all;
}

.related-name {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #231E1A;
  margin-right: 10rpx;
}

.related-plain {
  font-size: 24rpx;
  color: #8B8078;
}

.uncertain-title {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 46rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.uncertain-text {
  margin-top: 18rpx;
  font-size: 27rpx;
  line-height: 1.95;
  color: #544B44;
}

.missing {
  margin-top: 18rpx;
  padding-left: 24rpx;
  font-size: 26rpx;
  color: #544B44;
}

.missing-item {
  margin-bottom: 8rpx;
}

/* ---------- 对话式识别 ---------- */
.chat-title {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 40rpx;
  line-height: 1.5;
  color: #231E1A;
  margin-top: 8rpx;
}

.chat-sub {
  font-size: 26rpx;
  color: #8B8078;
  line-height: 1.8;
  margin: 10rpx 0 26rpx;
}

.chat {
  margin-top: 8rpx;
}

.chat-row {
  display: flex;
  margin-bottom: 20rpx;
}

.chat-row.is-user {
  justify-content: flex-end;
}

.chat-row.is-ai {
  justify-content: flex-start;
}

.bubble {
  max-width: 84%;
  padding: 20rpx 26rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  line-height: 1.8;
  word-break: break-all;
}

.bubble.is-user {
  background: #9E5A45;
  color: #FFF8F3;
  border-bottom-right-radius: 10rpx;
}

.bubble.is-ai {
  background: #FFFCF8;
  border: 1rpx solid #E7DCD1;
  color: #231E1A;
  border-bottom-left-radius: 10rpx;
  box-shadow: 0 12rpx 30rpx -24rpx rgba(63, 42, 30, 0.5);
}

.bubble.is-skip {
  background: #F3EBE2;
  border: 1rpx dashed #D9C9BA;
  color: #8B8078;
}

.options {
  display: flex;
  flex-wrap: wrap;
  margin: 4rpx 0 22rpx;
}

.option {
  border: 1rpx solid #D9C9BA;
  background: #FFFCF8;
  border-radius: 999rpx;
  padding: 16rpx 26rpx;
  font-size: 26rpx;
  color: #544B44;
  margin: 0 14rpx 14rpx 0;
}

.say-row {
  display: flex;
  align-items: center;
}

.say-input {
  flex: 1;
  height: 84rpx;
  min-height: 84rpx;
  padding: 0 28rpx;
  border: 1rpx solid #E7DCD1;
  border-radius: 999rpx;
  background: #FFFDFA;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.say-btn {
  flex: 0 0 auto;
  padding: 18rpx 34rpx;
}

.chat-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.chat-progress {
  font-size: 22rpx;
  color: #8B8078;
  letter-spacing: 1rpx;
}

.skip-link {
  font-size: 24rpx;
  color: #8B8078;
  padding: 8rpx 4rpx;
}

.candidate {
  background: #FFFCF8;
  border: 1rpx solid #E7DCD1;
  border-radius: 30rpx;
  padding: 36rpx 32rpx 28rpx;
  margin-top: 22rpx;
  box-shadow: 0 20rpx 60rpx -48rpx rgba(63, 42, 30, 0.5);
}

.candidate-index {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #B98670;
}

.candidate-name {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 42rpx;
  font-weight: 600;
  color: #231E1A;
  margin-top: 6rpx;
}

.candidate-plain {
  font-size: 28rpx;
  color: #7E4534;
  margin-top: 8rpx;
}

.candidate-scene {
  font-size: 26rpx;
  color: #544B44;
  line-height: 1.8;
  background: #F5EDE4;
  border-left: 4rpx solid #C08A6E;
  border-radius: 0 16rpx 16rpx 0;
  padding: 18rpx 22rpx;
  margin-top: 20rpx;
}

.candidate-go {
  font-size: 24rpx;
  color: #9E5A45;
  margin-top: 22rpx;
  letter-spacing: 1rpx;
}

.chosen-name {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 48rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.chosen-plain {
  font-size: 28rpx;
  color: #7E4534;
  margin-top: 10rpx;
}

.chosen-note {
  font-size: 27rpx;
  color: #544B44;
  line-height: 1.9;
  margin-top: 22rpx;
}

/* ---------- 理解 ---------- */
.depth-card {
  display: flex;
  align-items: flex-start;
  padding: 30rpx 28rpx;
  margin-top: 18rpx;
  border: 1rpx solid #E7DCD1;
  border-radius: 26rpx;
  background: #FFFCF8;
}

.depth-card-active {
  border-color: #9E5A45;
  background: #FFF9F5;
}

.depth-key {
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid #D9C9BA;
  color: #8B8078;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.depth-key-active {
  background: #9E5A45;
  border-color: #9E5A45;
  color: #FFF8F3;
}

.depth-body {
  flex: 1;
}

.depth-title {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 34rpx;
  font-weight: 600;
}

.depth-desc {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #544B44;
  line-height: 1.8;
}

.origins {
  margin-top: 22rpx;
}

.origins-hint {
  font-size: 24rpx;
  color: #8B8078;
  margin-bottom: 14rpx;
}

.origins-input {
  display: block;
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #E7DCD1;
  border-radius: 20rpx;
  background: #FFFDFA;
  font-size: 27rpx;
  line-height: 1.85;
  box-sizing: border-box;
}

.report-head-title {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 46rpx;
  line-height: 1.5;
  font-weight: 500;
  word-break: break-all;
}

.report-head-sub {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: #544B44;
}

.report-head-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8B8078;
}

.report-section {
  padding: 40rpx 0;
  border-top: 1rpx solid #E7DCD1;
}

.report-section-first {
  border-top: 0;
  padding-top: 12rpx;
}

.sec-title {
  display: flex;
  align-items: baseline;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.sec-index {
  font-family: "PingFang SC", sans-serif;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #C0836D;
  margin-right: 16rpx;
}

.rich {
  font-size: 29rpx;
  line-height: 1.95;
  color: #544B44;
  word-break: break-all;
}

.source-item {
  padding: 20rpx 0;
  border-bottom: 1rpx dashed #E7DCD1;
}

.source-title {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 26rpx;
  line-height: 1.7;
  color: #231E1A;
  word-break: break-all;
}

.source-venue {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #544B44;
  word-break: break-all;
}

.source-note {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8B8078;
}

.source-limit {
  margin-top: 20rpx;
  font-size: 23rpx;
  line-height: 1.9;
  color: #8B8078;
}

/* ---------- 成长 ---------- */
.dir-card {
  margin-top: 24rpx;
  padding: 36rpx 34rpx;
  border: 1rpx solid #E7DCD1;
  border-radius: 30rpx;
  background: #FFFCF8;
}

.dir-card-active {
  border-color: #9E5A45;
  background: #FFF9F5;
}

.dir-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.dir-num {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #C0836D;
  margin-right: 14rpx;
}

.dir-title {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 38rpx;
  font-weight: 600;
}

.badge {
  margin-left: 14rpx;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: #F3E4DD;
  color: #7E4534;
  font-size: 22rpx;
  white-space: nowrap;
}

.dir-desc {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.9;
  color: #544B44;
}

.scene {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-left: 3rpx solid #C0836D;
  border-radius: 0 16rpx 16rpx 0;
  background: #FBF6F0;
}

.scene-label,
.change-label {
  display: block;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #8B8078;
  margin-bottom: 6rpx;
}

.scene-text {
  font-size: 27rpx;
  line-height: 1.95;
  color: #231E1A;
}

.change {
  margin-top: 20rpx;
}

.change-text {
  font-size: 26rpx;
  line-height: 1.85;
  color: #5F7259;
}

.tasks {
  margin-top: 26rpx;
}

.task {
  padding: 26rpx 0;
  border-top: 1rpx dashed #E7DCD1;
}

.task-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #231E1A;
}

.task-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.85;
  color: #544B44;
}

.fb-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.fb {
  padding: 12rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  border: 1rpx solid #E7DCD1;
  border-radius: 999rpx;
  background: #FFFDFA;
  font-size: 24rpx;
  color: #544B44;
}

.fb-hover {
  border-color: #C0836D;
  color: #7E4534;
}

.reflection {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #E7DCD1;
  border-radius: 20rpx;
  background: #FBF6F0;
}

.reflection-label {
  font-size: 24rpx;
  color: #544B44;
  margin-bottom: 12rpx;
}

.reflection-input {
  display: block;
  width: 100%;
  padding: 16rpx 18rpx;
  border: 1rpx solid #E7DCD1;
  border-radius: 14rpx;
  background: #FFFDFA;
  font-size: 26rpx;
  box-sizing: border-box;
}

.log {
  display: flex;
  padding: 20rpx 0;
  border-top: 1rpx dashed #E7DCD1;
  font-size: 25rpx;
}

.log-time {
  flex: 0 0 130rpx;
  color: #8B8078;
  font-size: 23rpx;
}

.log-body {
  flex: 1;
  color: #544B44;
}

.log-feedback {
  font-weight: 600;
  color: #231E1A;
}

.log-reflection {
  display: block;
  margin-top: 4rpx;
  color: #231E1A;
  line-height: 1.8;
}

.mile {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx dashed #C0836D;
  border-radius: 24rpx;
  background: #FFFBF7;
}

.mile-confirmed {
  border-style: solid;
  border-color: #D8E2D2;
  background: #FCFEFB;
}

.mile-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.mile-title {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 34rpx;
  font-weight: 600;
}

.mile-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.95;
  color: #544B44;
}

.mile-meta {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #8B8078;
}

.section-title {
  margin-top: 36rpx;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 32rpx;
  font-weight: 600;
}
