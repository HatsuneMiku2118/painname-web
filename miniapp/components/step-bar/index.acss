.steps {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: stretch;
  margin: 0 -8rpx;
  padding: 16rpx 8rpx;
  background: #F8F3ED;
}

.board {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-right: 12rpx;
  padding: 18rpx 18rpx 20rpx;
  border: 1rpx solid #E7DCD1;
  border-radius: 22rpx;
  background: #FFFCF8;
  box-shadow: 0 6rpx 18rpx -14rpx rgba(63, 42, 30, 0.6);
}

.board:last-child {
  margin-right: 0;
}

.board-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.num {
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-size: 19rpx;
  letter-spacing: 2rpx;
  color: #B98670;
}

.state {
  font-size: 18rpx;
  color: #A2968C;
  white-space: nowrap;
}

.label {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #231E1A;
  white-space: nowrap;
}

.sub {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #8B8078;
  line-height: 1.4;
  white-space: nowrap;
}

.is-current {
  border-color: #C08A6E;
  background: #FFF8F3;
}

.is-current .state {
  color: #9E5A45;
}

.is-done .state {
  color: #5F7259;
}

.is-locked {
  opacity: 0.55;
  box-shadow: none;
}
