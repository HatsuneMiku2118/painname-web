<view class="steps">
  <view class="board {{current === 1 ? 'is-current' : ''}} {{done1 ? 'is-done' : ''}}" catchTap="onIdentify">
    <view class="board-top">
      <text class="num">01</text>
      <text class="state">{{current === 1 ? '当前' : (done1 ? '已完成' : '进入 →')}}</text>
    </view>
    <text class="label">识别与命名</text>
    <text class="sub">先弄清它是什么</text>
  </view>

  <view class="board {{current === 2 ? 'is-current' : ''}} {{done2 ? 'is-done' : ''}} {{enabled2 ? '' : 'is-locked'}}" catchTap="onUnderstand">
    <view class="board-top">
      <text class="num">02</text>
      <text class="state">{{current === 2 ? '当前' : (enabled2 ? (done2 ? '已完成' : '进入 →') : '未解锁')}}</text>
    </view>
    <text class="label">理解与探索</text>
    <text class="sub">它可能怎么运作</text>
  </view>

  <view class="board {{current === 3 ? 'is-current' : ''}} {{done3 ? 'is-done' : ''}} {{enabled3 ? '' : 'is-locked'}}" catchTap="onGrowth">
    <view class="board-top">
      <text class="num">03</text>
      <text class="state">{{current === 3 ? '当前' : (enabled3 ? (done3 ? '已记录' : '进入 →') : '未解锁')}}</text>
    </view>
    <text class="label">行动与成长</text>
    <text class="sub">把理解变成行动</text>
  </view>
</view>
