<view class="page">
  <step-bar current="{{1}}" done1="{{true}}" done2="{{hasReport}}" done3="{{hasLogs}}" enabled2="{{confirmed}}" enabled3="{{hasReport}}" />

  <view class="kicker">板块一 · 识别与命名</view>

  <!-- 对话式追问：一次只问一题 -->
  <block a:if="{{status === 'collecting' || status === 'followup'}}">
    <view class="chat-title">先聊几句，我再试着命名</view>
    <view class="chat-sub">不用组织语言，一次只问一件事。不想回答就跳过，不会影响你继续使用。</view>

    <view class="chat">
      <view a:for="{{thread}}" class="chat-row {{item.role === 'user' ? 'is-user' : 'is-ai'}}">
        <view class="bubble {{item.role === 'user' ? 'is-user' : 'is-ai'}} {{item.skip ? 'is-skip' : ''}}">{{item.text}}</view>
      </view>

      <block a:if="{{question}}">
        <view class="chat-row is-ai">
          <view class="bubble is-ai">{{question.text}}</view>
        </view>
        <view class="options">
          <view class="option" a:for="{{options}}" a:key="*this" data-text="{{item}}" onTap="onOption">{{item}}</view>
        </view>
        <view class="say-row">
          <input class="say-input" value="{{say}}" maxlength="200" onInput="onSayInput" confirm-type="send" onConfirm="onSend" placeholder="也可以用自己的话说" />
          <view class="btn btn-primary say-btn" onTap="onSend">发送</view>
        </view>
        <view class="chat-foot">
          <text class="chat-progress">{{progressText}}</text>
          <text class="skip-link" onTap="onSkip">这题跳过</text>
        </view>
      </block>
    </view>
  </block>

  <block a:elif="{{status === 'thinking'}}">
    <view class="chat-title">我在概念库里对照一下</view>
    <view class="chat-sub">只使用库里的条目，不会凭空造一个名字。</view>
    <view class="chat">
      <view a:for="{{thread}}" class="chat-row {{item.role === 'user' ? 'is-user' : 'is-ai'}}">
        <view class="bubble {{item.role === 'user' ? 'is-user' : 'is-ai'}} {{item.skip ? 'is-skip' : ''}}">{{item.text}}</view>
      </view>
      <view class="chat-row is-ai">
        <view class="bubble is-ai">正在整理你的描述…</view>
      </view>
    </view>
  </block>

  <block a:elif="{{status === 'awaiting_choice'}}">
    <view class="chat-title">它比较像这几种</view>
    <view class="chat-sub">点一张，看看它在你身上怎么运作。不是诊断；选错了，也可以回来换。</view>

    <view class="candidate" a:for="{{candidates}}" a:key="conceptId" data-id="{{item.conceptId}}" onTap="onChoose">
      <view class="candidate-index">0{{index + 1}}</view>
      <view class="candidate-name">{{item.name}}</view>
      <view class="candidate-plain">{{item.plain}}</view>
      <view class="candidate-scene" a:if="{{item.scene}}">{{item.scene}}</view>
      <view class="candidate-go">看看这个 →</view>
    </view>

    <view class="empty">这些只是可能的方向，不是结论。匹配依据、适用边界和来源会放在下一步，不堆在这里。</view>
    <view class="row">
      <view class="btn btn-quiet" onTap="onRestart">重新描述</view>
    </view>
  </block>

  <block a:elif="{{status === 'insufficient_information'}}">
    <view class="card">
      <view class="kicker">目前的结论是：不确定</view>
      <view class="uncertain-title">还不够可靠地命名</view>
      <view class="uncertain-text">你说的我都读到了，但还没法在概念库里找到一个真正贴合的解释。与其硬套一个术语，我更愿意停在这里。这不代表你的感受不重要，只说明线索还不够。</view>

      <view class="missing" a:if="{{fallbackMissing.length}}">
        <view class="empty mt-0">还缺少的部分：</view>
        <view class="missing-item" a:for="{{fallbackMissing}}" a:key="*this">· {{item}}</view>
      </view>

      <view class="q-text">如果愿意，可以再补充一点，我再看看。</view>
      <textarea class="q-input" auto-height maxlength="400" value="{{extra}}" onInput="onExtraInput" placeholder="比如：当时具体发生了什么、你后来做了什么……"></textarea>

      <view class="row">
        <view class="btn btn-primary" hover-class="btn-primary-hover" onTap="onMore">继续补充</view>
        <view class="btn btn-quiet" onTap="onRestart">重新描述</view>
      </view>
    </view>
  </block>

  <block a:else>
    <view class="card chosen">
      <view class="kicker">你选的方向</view>
      <view class="chosen-name">{{concept.name}}</view>
      <view class="chosen-plain">{{concept.plain}}</view>
      <view class="chosen-note">接下来会在这个概念的基础上，解释它可能怎么运作，并把匹配依据、适用边界和来源放在那里。</view>
      <view class="row">
        <view class="btn btn-primary" hover-class="btn-primary-hover" onTap="onContinue">去看看它怎么运作</view>
        <view class="btn btn-ghost" hover-class="btn-ghost-hover" a:if="{{canChange}}" onTap="onChangeCandidate">换一个候选</view>
        <view class="btn btn-quiet" onTap="onRestart">重新描述</view>
      </view>
    </view>
    <view class="disclaimer">以上是基于你当前描述的理解与知识匹配，不是心理诊断，也不代表你是一个怎样的人。</view>
  </block>
</view>
